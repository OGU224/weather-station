# OpenWeatherMap
OWM_API_KEY=
OWM_CITY=Lausanne
OWM_COUNTRY_CODE=CH
OWM_UNITS=metric
OWM_LANG=fr

# Google Cloud BigQuery
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
