# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_GAIN=3.0
LLM_TIMEOUT_SECONDS=12

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Device
DEVICE_ID=m5stack-01
