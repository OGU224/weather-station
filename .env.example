# OpenWeatherMap
OWM_API_KEY=
OWM_CITY=Lausanne
OWM_COUNTRY_CODE=CH
OWM_UNITS=metric
OWM_LANG=fr
IP_GEOLOCATION_ENABLED=true
IP_GEOLOCATION_URL=https://ipapi.co/json/
IP_GEOLOCATION_CACHE_SECONDS=1800
GOOGLE_GEOLOCATION_ENABLED=false
GOOGLE_GEOLOCATION_API_KEY=

# Google Cloud BigQuery
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
BQ_DATASET=weather_station

# Google Cloud Speech APIs
GOOGLE_TTS_LANGUAGE=en-US
GOOGLE_TTS_VOICE=en-US-Standard-F
GOOGLE_TTS_SPEAKING_RATE=1.0
GOOGLE_TTS_PITCH=0.0
GOOGLE_TTS_GAIN=2.0
GOOGLE_STT_LANGUAGE=en-US
GOOGLE_STT_ALT_LANGUAGES=fr-FR
GOOGLE_STT_RAW_SAMPLE_RATE=8000

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_GAIN=3.0
LLM_TIMEOUT_SECONDS=12

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Outdoor collector
OUTDOOR_COLLECTION_INTERVAL_SECONDS=600

# Device
DEVICE_ID=m5stack-01

# Spotify smart-home music
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/music/spotify/callback
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_DEVICE_ID=
SPOTIFY_MOOD_DEFAULT_URI=
SPOTIFY_MOOD_CLEAR_URI=
SPOTIFY_MOOD_CLOUD_URI=
SPOTIFY_MOOD_RAIN_URI=
SPOTIFY_MOOD_HOT_URI=
SPOTIFY_MOOD_COLD_URI=
